<mvc:View controllerName="mattns.invoices.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="page" title="{i18n>title}">
    <content>
        <Panel id="HeaderID" headerText="{i18n>selectscreen}">
            <Label id="labelShipName" labelFor="shipName" text="{i18n>shipNameLabel}" class="sapUiSmallMargin"/>
            <Input id="shipName" width="200px" class="sapUiSmallMarginEnd"/>
            <Label id="labelCountry" text="{i18n>countrylabel}" class="sapUiSmallMargin"/>
            <Select id="slCountry" selectedKey="{selectionScreen>/CountryKey}" forceSelection="false" items="{selectionScreen>/Countries}">
                <items>
                <core:Item id="coreItem" key="{selectionScreen>key}" text="{selectionScreen>text}"/>
                </items>
            </Select>
        </Panel>
    </content>
    </Page>
</mvc:View>